# 1story production environment template.
# Copy this file to .env.production and fill the private values.
# Never commit .env.production.

# Public canonical URL. Production must use HTTPS.
APP_URL=

# PostgreSQL.
POSTGRES_DB=one_story
POSTGRES_USER=one_story

# Generate as 32 random bytes encoded as 64 hexadecimal characters.
# Keep hexadecimal values so DATABASE_URL does not require URL-encoding.
POSTGRES_PASSWORD=

# Generate each independently as 32 random bytes encoded as 64 hexadecimal characters.
AUTH_SECRET=
ENCRYPTION_SECRET=

# Email.
# Configure before relying on verification, password reset or other email flows.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=true

# Optional social authentication.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Optional custom OAuth provider.
OAUTH_PROVIDER_NAME=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_DISCOVERY_URL=
OAUTH_AUTHORIZATION_URL=
OAUTH_TOKEN_URL=
OAUTH_USER_INFO_URL=
OAUTH_SCOPES=openid profile email

# Application flags.
FLAG_DISABLE_SIGNUPS=false
FLAG_DISABLE_EMAIL_AUTH=false
FLAG_DISABLE_IMAGE_PROCESSING=false
FLAG_DISABLE_API_RATE_LIMIT=false
FLAG_ALLOW_UNSAFE_OAUTH_REDIRECT_URI=false
FLAG_ALLOW_UNSAFE_AI_BASE_URL=false
